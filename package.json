{
  "name": "opencode-permission-ui",
  "version": "0.1.1",
  "description": "TUI screen for reviewing and pruning OpenCode's saved \"Allow always\" permission rules",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhrafin/opencode-permission-ui.git"
  },
  "keywords": [
    "opencode",
    "tui",
    "plugin",
    "permissions"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.3",
    "@opentui/solid": ">=0.8.3",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.27.1",
    "@opentui/core": "^0.8.3",
    "@opentui/solid": "^0.8.3",
    "babel-preset-solid": "^1.9.16",
    "solid-js": "^1.9.18",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
